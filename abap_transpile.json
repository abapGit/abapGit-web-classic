{
  "$schema": "./node_modules/@abaplint/transpiler-cli/schema.json",
  "input_folder": "src",
  "input_filter": [],
  "output_folder": "output",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core"
    },
    {
      "url": "https://github.com/open-abap/open-abap-seo"
    },
    {
      "url": "https://github.com/open-abap/open-abap-gui"
    },
    {
      "url": "https://github.com/abapGit/abapGit",
      "files": [
        "/src/**/zif_abapgit_*.intf.*",
        "/src/ui/core/zcl_abapgit_gui*.clas.*",
        "/src/ui/core/zcl_abapgit_html.clas.*",
        "/src/ui/core/zcl_abapgit_html_parts.clas.*",
        "/src/ui/routing/zcl_abapgit_gui_router.clas.*",
        "/src/ui/zcl_abapgit_frontend*.clas.*",
        "/src/ui/zcl_abapgit_popups.clas.*",
        "/src/ui/core/z.*",
        "/src/ui/zcl_abapgit_ui_factory.clas.*",
        "/src/utils/zcl_abapgit_convert.clas.*",
        "/src/utils/zcl_abapgit_string_buffer.clas.*"
      ]
    },
    {
      "url": "https://github.com/open-abap/express-icf-shim",
      "files": "/src/**/*.*"
    }
  ],
  "write_unit_tests": true,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError"
  }
}
